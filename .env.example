# Docker Compose Configuration
# This file is used by docker-compose.yml to configure services, ports, and environment variables.
# Copy to .env and customize for your environment.
# NOTE: .env is NOT used for local .NET development. See CLAUDE.md for local setup.

# Database (PostgreSQL)
POSTGRES_VERSION=18.4
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=locksmith
POSTGRES_HOST_PORT=5432
POSTGRES_CONTAINER_PORT=5432

# Cache (Redis)
REDIS_VERSION=7
REDIS_HOST_PORT=6379
REDIS_CONTAINER_PORT=6379

# API Application
API_HOST_PORT=8080
API_CONTAINER_PORT=8080

# Database connection string (for .NET app inside Docker)
# When running in Docker Compose, use 'postgres' as the hostname (not localhost)
# Variables are substituted at docker-compose startup
ConnectionStrings__DefaultConnection=Host=postgres;Port=${POSTGRES_CONTAINER_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# Redis connection string (for .NET app inside Docker)
# When running in Docker Compose, use 'redis' as the hostname
ConnectionStrings__Redis=redis:${REDIS_CONTAINER_PORT}

# API Settings
Api__BearerToken=dev-token-change-in-production

# Cryptography Settings (Argon2id parameters)
Cryptography__DegreeOfParallelism=1
Cryptography__MemorySize=65536
Cryptography__Iterations=4
