Src/Application/Services/**            @anthonynoelw
Src/Application/Commands/**            @anthonynoelw
Src/Application/Queries/**             @anthonynoelw
Src/Application/Handlers/**            @anthonynoelw

# Domain Layer (Core Business Rules)
Src/Domain/**                          @anthonynoelw
Src/Domain/Entities/**                 @anthonynoelw
